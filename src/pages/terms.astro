---
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/ui/Container.astro';
import Prose from '@/components/ui/Prose.astro';
import { fetchPolicyBySlug } from '@/services/content';
import { marked } from 'marked';

const policy = await fetchPolicyBySlug('terms');
const htmlContent = policy ? await marked.parse(policy.content) : '';
---

<PageLayout
  title={policy?.title || 'Terms of Service & Usage Agreement'}
  description="Terms and conditions governing your use of the Strat Ai software, billing services, and quantitative tools on stratai.live."
  badge="Legal"
  badgeVariant="default"
  breadcrumbs={[{ label: 'Terms of Service', href: '/terms' }]}
>
  <section class="py-16 md:py-20 bg-canvas transition-colors duration-300">
    <Container size="narrow">
      <Prose>
        {
          htmlContent ? (
            <div set:html={htmlContent} />
          ) : (
            <p class="text-muted-soft type-body-sm">
              Loading terms of service...
            </p>
          )
        }
      </Prose>
    </Container>
  </section>
</PageLayout>
