---
/**
 * Changelog — Product updates and release history fetched directly from backend database API.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import { fetchChangelogs } from '@/services/content';

const apiChangelogs = await fetchChangelogs();

const releases = apiChangelogs.map((item) => ({
  version: item.version,
  date: item.releaseDate
    ? new Date(item.releaseDate).toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
      })
    : '',
  tag:
    item.metadata?.tag ||
    (item.type === 'feature'
      ? 'Feature'
      : item.type === 'improvement'
        ? 'Improvement'
        : 'Update'),
  tagVariant: (item.metadata?.tagVariant ||
    (item.type === 'feature' ? 'violet' : 'emerald')) as
    'emerald' | 'violet' | 'orange' | 'pink' | 'default',
  changes: Array.isArray(item.changes) ? item.changes : [],
}));
---

<PageLayout
  title="Product Updates & Release Changelog"
  description="Stay updated with the latest product features, performance enhancements, terminal improvements, and quantitative model releases on Strat Ai."
  badge="Updates"
  badgeVariant="emerald"
  breadcrumbs={[{ label: 'Changelog' }]}
>
  <section class="py-16 md:py-20 bg-canvas transition-colors duration-300">
    <Container size="narrow">
      <div class="flex flex-col gap-0">
        {
          releases.map((release, i) => (
            <div class="relative pl-8 pb-12 last:pb-0">
              <div class="absolute left-0 top-1.5 w-3 h-3 rounded-full bg-brand-accent border-2 border-canvas z-10" />
              {i < releases.length - 1 && (
                <div class="absolute left-[5px] top-4 bottom-0 w-[1px] bg-hairline" />
              )}
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h3 class="type-title-md text-ink font-bold">
                  {release.version}
                </h3>
                <Badge variant={release.tagVariant}>{release.tag}</Badge>
                <span class="text-xs text-muted-soft">{release.date}</span>
              </div>
              <ul class="list-none flex flex-col gap-2">
                {release.changes.map((change) => (
                  <li class="flex items-start gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-muted-soft mt-2 shrink-0" />
                    <span class="type-body-sm text-muted">{change}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        {
          releases.length === 0 && (
            <div class="p-8 text-center text-muted">
              No product updates found in database.
            </div>
          )
        }
      </div>
    </Container>
  </section>
</PageLayout>
