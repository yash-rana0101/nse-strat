---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'text-link' | 'glass';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  liquidGlass?: boolean;
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className,
  id,
  type = 'button',
  liquidGlass: enableLiquidGlass = true,
  disabled = false,
} = Astro.props;
const Tag = href ? 'a' : 'button';

const baseClass =
  'liquid-glass-btn relative inline-flex items-center justify-center gap-2 font-body font-semibold cursor-pointer no-underline transition-all duration-300 ease-out active:scale-[0.96] overflow-hidden group select-none';

const sizeClasses = {
  sm: 'px-4 py-2 text-[13px] h-[36px] rounded-full',
  md: 'px-6 py-2.5 text-sm h-[42px] rounded-full',
  lg: 'px-8 py-3.5 text-base h-[50px] rounded-full',
};

const variantClasses = {
  primary:
    'bg-emerald-500/75 dark:bg-emerald-400/75 text-white dark:text-black border border-emerald-400/50 dark:border-emerald-300/60 shadow-[0_4px_24px_rgba(16,185,129,0.35),inset_0_1.5px_1px_rgba(255,255,255,0.5)] hover:bg-emerald-500/90 dark:hover:bg-emerald-400/90 hover:shadow-[0_8px_32px_rgba(16,185,129,0.55),inset_0_1.5px_1px_rgba(255,255,255,0.7)] hover:scale-[1.02]',
  secondary:
    'bg-surface-soft/60 dark:bg-surface-card/60 text-ink border border-hairline shadow-[0_4px_18px_rgba(0,0,0,0.06),inset_0_1.5px_1px_rgba(255,255,255,0.35)] hover:bg-surface-card/90 hover:border-emerald-500/40 hover:shadow-[0_6px_24px_rgba(16,185,129,0.25),inset_0_1.5px_1px_rgba(255,255,255,0.6)] hover:scale-[1.02]',
  glass:
    'bg-white/20 dark:bg-white/10 text-ink border border-white/35 dark:border-white/20 shadow-[0_8px_32px_rgba(0,0,0,0.12),inset_0_1.5px_1.5px_rgba(255,255,255,0.5)] hover:bg-white/35 dark:hover:bg-white/20 hover:border-emerald-400/50 hover:scale-[1.02]',
  ghost:
    'bg-transparent text-ink border border-transparent hover:bg-surface-card hover:border-hairline',
  'text-link':
    'bg-transparent text-ink border-none p-0 h-auto rounded-none hover:text-emerald-500 dark:hover:text-emerald-400',
};

const isGlassVariant =
  variant === 'primary' || variant === 'secondary' || variant === 'glass';
---

<Tag
  href={href}
  id={id}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[
    baseClass,
    sizeClasses[size],
    variantClasses[variant],
    className,
  ]}
  data-liquid-glass={enableLiquidGlass && isGlassVariant ? 'true' : undefined}
>
  {/* Specular Liquid Reflection Highlight Bar */}
  {
    isGlassVariant && (
      <span class="absolute inset-0 rounded-full bg-gradient-to-b from-white/35 via-transparent to-black/10 pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity" />
    )
  }
  {/* Subtle Hover Radial Liquid Shine */}
  {
    isGlassVariant && (
      <span class="absolute -inset-full bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.4)_0%,transparent_60%)] pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
    )
  }
  <span class="relative z-10 flex items-center justify-center gap-2">
    <slot />
  </span>
</Tag>

<script>
  import { liquidGlass } from '@/utils/liquid-glass';

  const instances = new Map<HTMLElement, ReturnType<typeof liquidGlass>>();

  function initButtonLiquidGlass() {
    const buttons = document.querySelectorAll<HTMLElement>(
      '[data-liquid-glass="true"]'
    );

    buttons.forEach((btn) => {
      if (instances.has(btn)) {
        instances.get(btn)?.refresh();
        return;
      }

      const instance = liquidGlass(btn, {
        scale: -70,
        chroma: 5,
        border: 0.05,
        mapBlur: 8,
        blur: 4,
        saturate: 1.5,
        fallbackBlur: 14,
      });

      instances.set(btn, instance);
    });
  }

  // Initialize on load & Astro swap
  initButtonLiquidGlass();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initButtonLiquidGlass);
  }

  document.addEventListener('astro:after-swap', () => {
    instances.forEach((inst) => inst.destroy());
    instances.clear();
    initButtonLiquidGlass();
  });

  // Observe theme updates to refresh glass maps
  const observer = new MutationObserver(() => {
    instances.forEach((inst) => inst.refresh());
  });
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
