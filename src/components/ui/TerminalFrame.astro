---
/**
 * TerminalFrame — window chrome for the product mock panels.
 *
 * Extracted from the inline mock that used to live in HowItWorks.astro so the
 * four feature mocks share one frame instead of duplicating traffic lights and
 * a header rule each.
 *
 * @example
 * <TerminalFrame label="VERIFY — PRE-TRADE AUDIT" status="INTRADAY">
 *   ...panels...
 * </TerminalFrame>
 */
import Badge from '@/components/ui/Badge.astro';

interface Props {
  label: string;
  status?: string;
  statusVariant?: 'emerald' | 'violet' | 'orange' | 'pink';
  class?: string;
}

const {
  label,
  status,
  statusVariant = 'emerald',
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'w-full bg-surface-soft border border-hairline rounded-card p-5 sm:p-6 flex flex-col gap-5 relative overflow-hidden shadow-2xl',
    className,
  ]}
>
  <div
    class="flex items-center justify-between gap-3 pb-4 border-b border-hairline/60"
  >
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-3 h-3 rounded-full bg-red-500/80 shrink-0"></span>
      <span class="w-3 h-3 rounded-full bg-yellow-500/80 shrink-0"></span>
      <span class="w-3 h-3 rounded-full bg-green-500/80 shrink-0"></span>
      <span class="text-xs font-mono text-muted pl-2 truncate">{label}</span>
    </div>
    {
      status && (
        <Badge
          variant={statusVariant}
          class="text-[10px] uppercase font-semibold shrink-0"
        >
          {status}
        </Badge>
      )
    }
  </div>
  <slot />
</div>
