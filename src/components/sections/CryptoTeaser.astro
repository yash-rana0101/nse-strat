---
/**
 * CryptoTeaser — Strat AI Crypto, in development.
 *
 * A notice, not a feature section. Copy lives in
 * `src/content/landing/crypto.ts` and deliberately carries no capability
 * claims and no date.
 */
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { crypto } from '@/content/landing';
---

<section
  class="section-y bg-canvas transition-colors duration-300"
  id={crypto.id}
  aria-labelledby="crypto-heading"
>
  <Container>
    <div
      class="relative rounded-card border border-dashed border-hairline bg-surface-soft/30 p-6 sm:p-10 md:p-14 overflow-hidden"
      data-reveal-group
    >
      <div
        class="absolute -top-24 -right-24 w-[300px] h-[300px] bg-badge-violet/10 blur-[110px] rounded-full pointer-events-none"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative z-10 flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-12"
      >
        <div class="flex flex-col items-start gap-4 flex-1">
          <div class="flex items-center gap-2.5 flex-wrap" data-reveal-item>
            <Badge variant="violet">{crypto.badge}</Badge>
            <span
              class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-muted-soft border border-hairline/60 rounded-full px-2.5 py-1"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-badge-violet"></span>
              {crypto.status}
            </span>
          </div>

          <h2
            id="crypto-heading"
            class="type-display-sm text-ink leading-snug"
            data-reveal-item
          >
            {crypto.heading}
          </h2>

          <p class="type-body-md text-muted leading-relaxed" data-reveal-item>
            {crypto.body}
          </p>

          <ul class="flex flex-wrap gap-2 mt-1" role="list" data-reveal-item>
            {
              crypto.points.map((point) => (
                <li class="font-mono text-[10px] tracking-wider px-2.5 py-1.5 rounded border border-hairline/60 bg-surface-card text-muted-soft">
                  {point}
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="flex flex-col items-start gap-4 lg:max-w-[280px] lg:border-l lg:border-hairline lg:pl-10"
          data-reveal-item
        >
          <p class="text-xs text-muted-soft leading-relaxed">
            {crypto.note}
          </p>
          <Button variant="secondary" size="md" href={crypto.cta.href}>
            {crypto.cta.label}
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
