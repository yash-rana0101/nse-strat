---
/**
 * Hero — Center-aligned header & 3D cosmic planet hero section.
 *
 * Copy comes from `src/content/landing/hero.ts`. Layering architecture:
 * z-0  : 3D cosmic planet horizon & glow arc
 * z-10 : vertical side border lines (overlay the planet glow curve)
 * z-20 : header content
 */
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import HeroIllustration from './HeroIllustration.astro';
import { hero } from '@/content/landing';
---

<section
  class="relative pt-20 sm:pt-24 lg:pt-28 pb-0 overflow-hidden bg-canvas transition-colors duration-300 min-h-screen flex flex-col justify-between"
  id="hero"
  aria-labelledby="hero-heading"
>
  <!-- Subtle starfield & background radial ambient glow in brand emerald -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div
      class="hero-starfield absolute inset-0 opacity-[0.25]"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.2) 1px, transparent 0); background-size: 36px 36px;"
    >
    </div>
    <div
      class="absolute top-[8%] left-1/2 -translate-x-1/2 w-[700px] h-[240px] bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.18)_0%,transparent_70%)] blur-[100px]"
    >
    </div>
  </div>

  <Container size="wide" class="relative z-20">
    <div
      class="flex flex-col items-center text-center gap-3 max-w-3xl mx-auto"
      data-reveal-group
    >
      <!-- Top pill badge -->
      <div data-reveal-item class="reveal reveal-scale-up">
        <div
          class="inline-flex items-center gap-2 px-4 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 backdrop-blur-md text-xs font-medium text-emerald-600 dark:text-emerald-400 shadow-sm"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400"
          ></span>
          <span
            >{hero.attribution.prefix}{' '}<a
              href={hero.attribution.href}
              class="text-ink font-semibold hover:underline"
              target="_blank"
              rel="noopener noreferrer">{hero.attribution.label}</a
            ></span
          >
        </div>
      </div>

      <h1
        id="hero-heading"
        class="text-4xl sm:text-5xl md:text-6xl font-body font-bold tracking-tight text-ink leading-[1.08] text-center max-w-2xl reveal reveal-scale-up"
        data-reveal-item
      >
        {hero.heading}
      </h1>

      <p
        class="type-body-md text-body text-sm sm:text-base leading-relaxed max-w-xl text-center font-normal reveal reveal-scale-up"
        data-reveal-item
      >
        {hero.body}
      </p>

      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-1 reveal reveal-scale-up"
        data-reveal-item
      >
        <Button
          variant="primary"
          size="lg"
          href={hero.primaryCta.href}
          class="!rounded-full px-8 py-3 bg-emerald-500 dark:bg-emerald-400 text-white dark:text-black font-semibold text-sm shadow-[0_0_30px_rgba(16,185,129,0.4)] hover:shadow-[0_0_40px_rgba(16,185,129,0.7)] hover:scale-[1.03] transition-all duration-300 border-none"
        >
          {hero.primaryCta.label}
        </Button>
        <Button
          variant="secondary"
          size="lg"
          href={hero.secondaryCta.href}
          class="!rounded-full px-8 py-3 text-sm"
        >
          {hero.secondaryCta.label}
        </Button>
      </div>

      <p
        class="text-xs text-muted-soft max-w-md leading-relaxed mt-1"
        data-reveal-item
      >
        {hero.note}
      </p>
    </div>
  </Container>

  <!-- Glowing 3D planet horizon (entry reveal & scroll parallax) -->
  <div
    class="w-full relative z-10 mt-6 sm:mt-8 md:mt-10 flex-1 flex flex-col justify-start reveal reveal-scale-up"
    data-reveal-group
  >
    <HeroIllustration />
  </div>

  <!-- Bottom seamless transition fade into bg-canvas -->
  <div
    class="absolute bottom-0 inset-x-0 h-28 bg-gradient-to-b from-transparent via-canvas/70 to-canvas pointer-events-none z-30"
  >
  </div>
</section>

<style>
  /* Light mode: hide the white starfield dots (invisible anyway), use subtle dark dots instead */
  [data-theme='light'] .hero-starfield {
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(0, 0, 0, 0.08) 1px,
      transparent 0
    ) !important;
    opacity: 0.4 !important;
  }
</style>
