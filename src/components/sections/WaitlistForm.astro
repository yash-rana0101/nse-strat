---
// src/components/sections/WaitlistForm.astro
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import Input from '@/components/ui/Input.astro';
import Icon from '@/components/ui/Icon.astro';
import Badge from '@/components/ui/Badge.astro';
import ThankYouModal from '@/components/ui/ThankYouModal.astro';

// We read PUBLIC_GOOGLE_CLIENT_ID from environment
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '';
---

<!-- Include Google Sign-In SDK -->
<script is:inline src="https://accounts.google.com/gsi/client" async defer
></script>

<div class="w-full max-w-[520px] mx-auto" data-reveal-group>
  <!-- Main Form Card -->
  <div id="waitlist-form-container" class="block transition-all duration-300">
    <Card
      variant="feature"
      padding="lg"
      class="border border-hairline/80 shadow-[0_20px_50px_rgba(16,185,129,0.04)] relative overflow-hidden"
    >
      <!-- Background glow -->
      <div
        class="absolute -top-12 -right-12 w-40 h-40 bg-[radial-gradient(circle,rgba(16,185,129,0.08)_0%,transparent_70%)] pointer-events-none"
      >
      </div>

      <div class="flex flex-col gap-6" data-reveal-item>
        <div class="text-center md:text-left">
          <Badge variant="emerald" class="mb-3 inline-flex"
            >Launching soon</Badge
          >
          <h2 class="type-display-sm font-bold text-ink leading-tight">
            Join the Waitlist
          </h2>
          <p class="type-body-sm text-muted mt-2">
            Strat AI is not open yet while we complete the regulatory and
            compliance approvals required before launch. Join the waitlist and
            we will notify you soon.
          </p>
        </div>

        <!-- Error Alert -->
        <div
          id="waitlist-error-alert"
          class="hidden p-3 bg-red-500/10 border border-red-500/20 text-red-500 text-xs rounded-lg transition-all duration-300"
        >
          <div class="flex items-center gap-2">
            <Icon name="alert-triangle" size={16} class="shrink-0" />
            <span id="waitlist-error-message"
              >Something went wrong. Please try again.</span
            >
          </div>
        </div>

        <!-- Google Sign-In Button Container -->
        <div
          class="w-full min-h-[44px] flex justify-center items-center"
          data-google-id={googleClientId}
        >
          <button
            type="button"
            id="google-signin-placeholder"
            class="w-full h-11 flex items-center justify-center gap-3 bg-surface-soft hover:bg-surface-strong border border-hairline hover:border-muted/30 text-ink rounded-lg font-body font-semibold text-sm transition-all duration-200 active:scale-[0.98] cursor-pointer"
          >
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              ></path>
              <path
                fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path>
              <path
                fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
              ></path>
              <path
                fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 6.31l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              ></path>
            </svg>
            Continue with Google
          </button>
        </div>

        <div class="flex items-center gap-4">
          <div class="h-[1px] flex-1 bg-hairline"></div>
          <span
            class="text-xs text-muted-soft uppercase font-bold tracking-wider"
            >or join with email</span
          >
          <div class="h-[1px] flex-1 bg-hairline"></div>
        </div>

        <!-- Main Form -->
        <!--
          toolname / tooldescription expose this form to AI agents via the
          WebMCP declarative API. They survive into server-rendered HTML, so a
          crawler that never runs JavaScript can still see what the form does.
        -->
        <form
          id="waitlist-form"
          class="flex flex-col gap-4"
          toolname="join_private_beta"
          tooldescription="Register a name and email address for Strat AI private beta access. This is the only way to get access to the terminal; there is no self-serve signup."
        >
          <div class="flex flex-col gap-1.5">
            <label for="waitlist-name" class="text-xs font-semibold text-ink"
              >Name</label
            >
            <Input
              id="waitlist-name"
              name="name"
              type="text"
              placeholder="e.g. Your Name"
              required
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="waitlist-email" class="text-xs font-semibold text-ink"
              >Email Address</label
            >
            <Input
              id="waitlist-email"
              name="email"
              type="email"
              placeholder="e.g. mail@example.com"
              required
            />
          </div>

          <Button
            type="submit"
            variant="primary"
            size="lg"
            class="w-full justify-center mt-2"
            id="submit-btn"
          >
            <span id="submit-text">Notify Me</span>
            <span
              id="submit-spinner"
              class="hidden w-5 h-5 border-2 border-on-primary border-t-transparent rounded-full animate-spin"
            ></span>
          </Button>
        </form>
      </div>
    </Card>
  </div>

  <!-- Success Card (hidden by default) -->
  <div
    id="waitlist-success-container"
    class="hidden transition-all duration-300"
  >
    <Card
      variant="feature"
      padding="lg"
      class="border border-brand-accent/30 shadow-[0_20px_50px_rgba(16,185,129,0.08)] text-center relative overflow-hidden"
    >
      <div
        class="absolute -top-12 -left-12 w-40 h-40 bg-[radial-gradient(circle,rgba(16,185,129,0.1)_0%,transparent_70%)] pointer-events-none"
      >
      </div>

      <div class="flex flex-col items-center gap-6">
        <div
          class="w-16 h-16 bg-brand-accent/10 border border-brand-accent/20 text-brand-accent rounded-full flex items-center justify-center checkmark-circle-animated"
        >
          <Icon name="check" size={32} />
        </div>

        <div>
          <h2 class="type-display-sm font-bold text-ink">
            You will be the first to know
          </h2>
          <p class="type-body-sm text-muted mt-2">
            You're on the waitlist. We've saved <span
              id="success-user-name"
              class="font-semibold text-ink"></span> (<span
              id="success-user-email"></span>).
          </p>
        </div>

        <div
          class="w-full bg-surface-soft border border-hairline rounded-xl p-6 flex flex-col items-center gap-3"
        >
          <span
            class="text-xs font-bold text-muted-soft uppercase tracking-wider"
            >Your Waitlist Spot</span
          >
          <span
            class="text-3xl font-display font-extrabold text-brand-accent"
            id="success-queue-spot">#1,842</span
          >
          <p class="text-xs text-muted">
            We will email you as soon as Strat AI launches.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 w-full mt-2">
          <Button
            variant="secondary"
            href="/"
            class="flex-1 justify-center !rounded-full">Back to Home</Button
          >
          <Button
            variant="secondary"
            href="/docs"
            class="!bg-brand-accent !text-canvas !border-transparent hover:opacity-90 flex-1 justify-center !rounded-full"
            >Read Docs</Button
          >
        </div>
      </div>
    </Card>
  </div>

  <ThankYouModal />
</div>

<script>
  import './waitlistClient';
</script>
