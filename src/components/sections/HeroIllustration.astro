---
/**
 * HeroIllustration — Actual Strat AI Terminal Product Screenshot (/hero/hero-dark.png).
 * Mounted inside a sleek floating glass terminal frame over the glowing 3D cosmic planet horizon.
 * Supports light/dark theme with proper image swap and adapted colors.
 */
---

<div
  class="relative w-full min-h-[420px] sm:min-h-[500px] lg:min-h-[560px] flex items-start justify-center pt-4 sm:pt-6 pb-8 px-2 sm:px-6"
>
  <!-- Planet Dome Parallax Background (z-0 sits UNDER vertical side border lines) -->
  <div
    id="hero-planet-wrapper"
    class="absolute top-2 sm:top-4 inset-x-0 w-full flex justify-center pointer-events-none z-0 overflow-visible"
  >
    <div
      id="hero-planet-target"
      class="relative w-[135vw] max-w-none flex flex-col items-center justify-start origin-top shrink-0"
    >
      <!-- Glowing Atmosphere Soft Layer Behind Planet Arc -->
      <div
        class="hero-atmosphere absolute top-0 w-full h-[320px] rounded-[50%] bg-[radial-gradient(ellipse_at_top,rgba(16,185,129,0.65)_0%,rgba(6,182,212,0.4)_35%,rgba(5,150,105,0.15)_70%,transparent_90%)] blur-[45px] pointer-events-none animate-atmosphere-opacity"
      >
      </div>

      <!-- Full-Bleed 3D Curved Planet Horizon SVG -->
      <svg
        viewBox="0 0 1440 400"
        preserveAspectRatio="none"
        class="w-full h-[320px] sm:h-[380px] lg:h-[420px]"
      >
        <defs>
          <!-- Dark mode gradient -->
          <radialGradient
            id="stratBrandGradientDark"
            cx="50%"
            cy="0%"
            r="90%"
            fx="50%"
            fy="0%"
          >
            <stop offset="0%" stop-color="#10b981" stop-opacity="0.95"></stop>
            <stop offset="25%" stop-color="#059669" stop-opacity="0.85"></stop>
            <stop offset="55%" stop-color="#047857" stop-opacity="0.65"></stop>
            <stop offset="80%" stop-color="#022c22" stop-opacity="0.4"></stop>
            <stop offset="100%" stop-color="#0a0a0a" stop-opacity="0"></stop>
          </radialGradient>

          <!-- Light mode gradient -->
          <radialGradient
            id="stratBrandGradientLight"
            cx="50%"
            cy="0%"
            r="90%"
            fx="50%"
            fy="0%"
          >
            <stop offset="0%" stop-color="#34d399" stop-opacity="0.7"></stop>
            <stop offset="25%" stop-color="#6ee7b7" stop-opacity="0.5"></stop>
            <stop offset="55%" stop-color="#a7f3d0" stop-opacity="0.35"></stop>
            <stop offset="80%" stop-color="#d1fae5" stop-opacity="0.15"></stop>
            <stop offset="100%" stop-color="#eef7e7" stop-opacity="0"></stop>
          </radialGradient>

          <linearGradient id="stratRimGlow" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.6"></stop>
            <stop offset="50%" stop-color="#34d399" stop-opacity="0.95"></stop>
            <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.6"></stop>
          </linearGradient>

          <filter id="softRimBlur" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="8"></feGaussianBlur>
          </filter>
        </defs>

        <!-- Dark mode planet fill -->
        <path
          class="hero-planet-dark"
          d="M -200 400 Q 720 10 1640 400 L 1640 400 L -200 400 Z"
          fill="url(#stratBrandGradientDark)"></path>
        <!-- Light mode planet fill (hidden by default) -->
        <path
          class="hero-planet-light"
          d="M -200 400 Q 720 10 1640 400 L 1640 400 L -200 400 Z"
          fill="url(#stratBrandGradientLight)"
          style="display:none;"></path>

        <path
          d="M -200 400 Q 720 10 1640 400"
          fill="none"
          stroke="url(#stratRimGlow)"
          stroke-width="10"
          filter="url(#softRimBlur)"
          class="animate-rim-glow"></path>
      </svg>
    </div>
  </div>

  <!-- FLOATING GLASS TERMINAL HERO PRODUCT IMAGE FRAME -->
  <div
    id="hero-card-left"
    data-reveal-item
    class="hero-terminal-frame reveal-item relative z-20 w-full max-w-6xl lg:max-w-7xl rounded-2xl sm:rounded-3xl overflow-hidden mt-4 sm:mt-6 transition-transform duration-150 ease-out border border-black/10 dark:border-white/15 bg-white/90 dark:bg-surface-card/90 backdrop-blur-2xl shadow-[0_35px_100px_rgba(0,0,0,0.15)] dark:shadow-[0_35px_100px_rgba(0,0,0,0.9)]"
  >
    <!-- Product Image Container -->
    <div class="w-full relative bg-gray-50 dark:bg-[#070809]">
      <img
        id="hero-illustration-image"
        src="/hero/hero-dark.png"
        alt="Strat AI Terminal Dashboard Screenshot"
        width={1920}
        height={988}
        class="w-full h-auto object-cover block"
        loading="eager"
        fetchpriority="high"
        data-dark-src="/hero/hero-dark.png"
        data-light-src="/hero/hero-light.png"
      />
    </div>
  </div>
</div>

<script>
  function initHeroIllustration() {
    // Parallax scroll logic
    const heroSection = document.getElementById('hero');
    const planetTarget = document.getElementById('hero-planet-target');
    const terminalCard = document.getElementById('hero-card-left');

    if (heroSection && planetTarget && terminalCard) {
      let ticking = false;

      function onScroll() {
        if (!heroSection || !planetTarget || !terminalCard) return;

        const scrollY = window.scrollY;
        const heroHeight = heroSection.offsetHeight || 800;

        if (scrollY <= heroHeight) {
          const progress = scrollY / heroHeight;
          const planetTranslateY = progress * 30;
          const planetScale = 1 + progress * 0.04;
          const terminalTranslateY = progress * -18;

          planetTarget.style.transform = `translate3d(0, ${planetTranslateY}px, 0) scale(${planetScale})`;
          terminalCard.style.transform = `translate3d(0, ${terminalTranslateY}px, 0)`;
        }
        ticking = false;
      }

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            requestAnimationFrame(onScroll);
            ticking = true;
          }
        },
        { passive: true }
      );
    }

    // Light/Dark Theme Sync for Hero Image + Planet SVG
    function syncTheme() {
      const theme = document.documentElement.getAttribute('data-theme');
      const isLight = theme === 'light';

      // Swap hero image
      const heroImg = document.getElementById(
        'hero-illustration-image'
      ) as HTMLImageElement | null;
      if (heroImg) {
        const lightSrc = heroImg.getAttribute('data-light-src');
        const darkSrc = heroImg.getAttribute('data-dark-src');
        const targetSrc = isLight ? lightSrc : darkSrc;
        if (targetSrc && !heroImg.src.endsWith(targetSrc)) {
          heroImg.src = targetSrc;
        }
      }

      // Swap planet SVG fill visibility
      const darkPlanet = document.querySelector(
        '.hero-planet-dark'
      ) as SVGPathElement | null;
      const lightPlanet = document.querySelector(
        '.hero-planet-light'
      ) as SVGPathElement | null;
      if (darkPlanet && lightPlanet) {
        if (isLight) {
          darkPlanet.style.display = 'none';
          lightPlanet.style.display = '';
        } else {
          darkPlanet.style.display = '';
          lightPlanet.style.display = 'none';
        }
      }
    }

    // Run on init
    syncTheme();

    // Watch for theme changes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-theme') {
          syncTheme();
        }
      });
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }

  initHeroIllustration();
  document.addEventListener('astro:after-swap', initHeroIllustration);
</script>

<style>
  @keyframes atmosphereOpacity {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes rimGlowShift {
    0% {
      opacity: 0.75;
      stroke: url(#stratRimGlow);
    }
    50% {
      opacity: 1;
      stroke: url(#stratRimGlow);
    }
    100% {
      opacity: 0.75;
      stroke: url(#stratRimGlow);
    }
  }

  .animate-atmosphere-opacity {
    animation: atmosphereOpacity 6s ease-in-out infinite;
  }

  .animate-rim-glow {
    animation: rimGlowShift 4s ease-in-out infinite;
  }

  /* Light mode: soften the atmosphere glow */
  [data-theme='light'] .hero-atmosphere {
    background: radial-gradient(
      ellipse at top,
      rgba(16, 185, 129, 0.35) 0%,
      rgba(6, 182, 212, 0.2) 35%,
      rgba(5, 150, 105, 0.08) 70%,
      transparent 90%
    ) !important;
    filter: blur(60px) !important;
  }
</style>
