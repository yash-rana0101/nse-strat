---
/**
 * Security — what the terminal refuses to do.
 *
 * Renders `src/content/landing/refusals.ts`. Reframed from a vault claim to a
 * refusal list because FEATURE_CATALOGUE section 13.3 could not verify the
 * Argon2id / AES-256 / Tauri Stronghold implementation, while every claim in
 * the refusal list is code-verified and two of them are enforced by tests.
 *
 * Anchor id stays `#security` for existing inbound links.
 */
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import { refusals as content } from '@/content/landing';

const { intro, pills, refusals } = content;

const pillIconClasses = {
  emerald: 'text-badge-emerald',
  violet: 'text-badge-violet',
  orange: 'text-badge-orange',
  pink: 'text-badge-pink',
};
---

<section
  class="section-y bg-canvas transition-colors duration-300"
  id={intro.id}
  aria-labelledby="security-heading"
>
  <Container size="wide" class="!px-0">
    <div
      class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] border-y border-hairline overflow-hidden divide-y lg:divide-y-0 lg:divide-x divide-hairline bg-surface-soft/5"
    >
      <!-- Left: heading, shield, pills -->
      <div
        class="flex flex-col items-start gap-6 p-6 sm:p-8 md:p-12 lg:p-14 justify-center relative overflow-hidden group/shield"
        data-reveal-group
      >
        <div
          class="absolute -right-24 -bottom-24 w-[320px] h-[320px] bg-brand-accent/10 opacity-60 group-hover/shield:opacity-90 blur-[100px] rounded-full transition-opacity duration-1000 pointer-events-none"
          aria-hidden="true"
        >
        </div>

        <div data-reveal-item>
          <Badge variant="emerald">{intro.badge}</Badge>
        </div>
        <h2
          id="security-heading"
          class="type-display-md leading-[1.15] tracking-tight text-ink relative z-10"
          data-reveal-item
        >
          {intro.heading}
        </h2>
        {
          intro.body && (
            <p
              class="type-body-md text-muted leading-relaxed relative z-10"
              data-reveal-item
            >
              {intro.body}
            </p>
          )
        }

        <div class="flex flex-wrap gap-2 relative z-10" data-reveal-item>
          {
            pills.map((pill) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-card border border-hairline/60 rounded-full text-xs text-muted">
                <Icon
                  name={pill.icon}
                  size={12}
                  class={pillIconClasses[pill.accent]}
                />
                {pill.label}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Right: the refusal list -->
      <div
        class="flex flex-col justify-center p-6 sm:p-8 md:p-12 lg:p-14"
        data-reveal-group
      >
        <dl class="flex flex-col gap-6" role="list">
          {
            refusals.map((refusal) => (
              <div class="flex gap-4" data-reveal-item>
                <div
                  class="w-5 h-5 rounded-full bg-error/15 text-error flex items-center justify-center shrink-0 mt-1"
                  aria-hidden="true"
                >
                  <svg
                    class="w-3 h-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <dt class="type-title-sm text-ink font-semibold">
                    {refusal.title}
                  </dt>
                  <dd class="type-body-sm text-muted leading-relaxed mt-1">
                    {refusal.body}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Container>
</section>
