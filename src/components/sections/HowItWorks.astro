---
/**
 * HowItWorks — the three-layer engine underneath the headline features.
 *
 * Answers the question the deep dives raise: where do the numbers come from,
 * and why can the model not invent one. Copy lives in
 * `src/content/landing/engine.ts`.
 *
 * The terminal dashboard and tab bar that used to live here now live in
 * `src/components/mocks/` and `src/components/ui/TabSwitcher.astro`.
 */
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import { engine } from '@/content/landing';

const { intro, layers, punchline } = engine;
---

<section
  class="section-y bg-canvas transition-colors duration-300"
  id={intro.id}
  aria-labelledby="engine-heading"
>
  <Container>
    <div
      class="max-w-[800px] mx-auto text-center mb-12 md:mb-16"
      data-reveal-group
    >
      <div data-reveal-item>
        <Badge variant="emerald" class="mb-4">{intro.badge}</Badge>
      </div>
      <h2
        id="engine-heading"
        class="type-display-lg leading-[1.1] tracking-tight text-ink"
        data-reveal-item
      >
        {intro.heading}
      </h2>
      {
        intro.body && (
          <p class="type-body-md text-muted mt-4" data-reveal-item>
            {intro.body}
          </p>
        )
      }
    </div>
  </Container>

  <Container size="wide" class="!px-0">
    <div class="border-y border-hairline overflow-hidden bg-surface-soft/5">
      <!-- The three layers -->
      <div
        class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-hairline border-b border-hairline"
        data-reveal-group
      >
        {
          layers.map((layer) => (
            <div class="reveal-item p-6 sm:p-8 md:p-10 flex flex-col gap-4 hover:bg-surface-soft/10 transition-colors">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold text-muted-soft">
                  {layer.index}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-badge-emerald">
                  {layer.label}
                </span>
              </div>
              <h3 class="type-title-lg text-ink font-bold leading-snug">
                {layer.heading}
              </h3>
              <p class="type-body-sm text-muted leading-relaxed flex-1">
                {layer.body}
              </p>
              <ul class="list-none flex flex-wrap gap-1.5 mt-1" role="list">
                {layer.chips.map((chip) => (
                  <li class="font-mono text-[9px] tracking-wider px-2 py-1 rounded border border-hairline/60 bg-surface-card text-muted-soft">
                    {chip}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <!-- Why it matters -->
      <div class="p-6 sm:p-8 md:p-12" data-reveal-group>
        <div class="max-w-[800px] mx-auto text-center md:text-left">
          <div
            class="flex items-center gap-2 mb-4 justify-center md:justify-start"
            data-reveal-item
          >
            <span class="w-1.5 h-1.5 rounded-full bg-badge-emerald"></span>
            <span
              class="text-[10px] font-mono font-bold tracking-widest uppercase text-badge-emerald"
              >{punchline.label}</span
            >
          </div>
          <h3
            class="type-display-sm text-ink leading-snug mb-4"
            data-reveal-item
          >
            {punchline.heading}
          </h3>
          <p class="type-body-md text-muted leading-relaxed" data-reveal-item>
            {punchline.body}
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
