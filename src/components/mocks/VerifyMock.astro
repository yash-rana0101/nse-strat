---
/**
 * VerifyMock — a rejection, not a pass.
 *
 * The panel deliberately shows a setup that fails the stop-distance check and
 * returns the `stop-too-tight` reason tag, with the reward-to-risk check marked
 * unreached because the checks stop at the first failure.
 */
import TerminalFrame from '@/components/ui/TerminalFrame.astro';
import { verifyMock } from '@/content/landing';

const stateStyles = {
  pass: {
    text: 'text-success',
    mark: '✓',
  },
  fail: {
    text: 'text-error',
    mark: '✕',
  },
  skipped: {
    text: 'text-muted-soft',
    mark: '–',
  },
} as const;
---

<TerminalFrame
  label={verifyMock.frameLabel}
  status={verifyMock.status}
  statusVariant="orange"
>
  <!-- Levels supplied by the trader -->
  <div
    class="bg-surface-card border border-hairline/50 p-4 rounded-panel flex flex-col gap-3"
  >
    <span
      class="text-[10px] font-mono uppercase tracking-widest text-muted-soft"
    >
      {verifyMock.inputsLabel}
    </span>
    <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2.5">
      {
        verifyMock.inputs.map((input) => (
          <div class="flex flex-col gap-0.5 min-w-0">
            <dt class="text-[10px] text-muted-soft truncate">{input.label}</dt>
            <dd class="text-xs font-mono font-bold text-ink">{input.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Deterministic checks, in order -->
  <div
    class="bg-surface-card border border-hairline/50 p-4 rounded-panel flex flex-col gap-3"
  >
    <span
      class="text-[10px] font-mono uppercase tracking-widest text-muted-soft"
    >
      {verifyMock.checksLabel}
    </span>
    <ul class="list-none flex flex-col gap-0" role="list">
      {
        verifyMock.checks.map((check) => {
          const style = stateStyles[check.state];
          return (
            <li class="flex items-start justify-between gap-3 text-xs py-2 border-b border-hairline/30 last:border-b-0">
              <span class="flex items-start gap-2 min-w-0">
                <span
                  class:list={[
                    'font-mono font-bold shrink-0 leading-5',
                    style.text,
                  ]}
                  aria-hidden="true"
                >
                  {style.mark}
                </span>
                <span class="text-muted leading-5">{check.label}</span>
              </span>
              <span
                class:list={[
                  'font-mono font-semibold shrink-0 leading-5',
                  style.text,
                ]}
              >
                {check.detail}
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- Verdict -->
  <div
    class="border border-error/40 bg-error/5 rounded-panel p-4 flex flex-col gap-2"
  >
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <span class="text-sm font-bold tracking-widest text-error">
        {verifyMock.verdict.label}
      </span>
      <span
        class="font-mono text-[10px] px-2 py-0.5 rounded border border-error/40 text-error"
      >
        {verifyMock.verdict.tag}
      </span>
    </div>
    <p class="text-xs text-muted leading-relaxed">
      {verifyMock.verdict.note}
    </p>
  </div>

  <!-- Bear agent -->
  <div
    class="bg-surface-card border border-hairline/50 p-4 rounded-panel flex flex-col gap-3"
  >
    <span
      class="text-[10px] font-mono uppercase tracking-widest text-badge-violet"
    >
      {verifyMock.critiqueLabel}
    </span>
    <ul class="list-none flex flex-col gap-2" role="list">
      {
        verifyMock.critique.map((item) => (
          <li class="flex items-start gap-2 text-xs text-muted leading-relaxed">
            <span
              class="w-1 h-1 rounded-full bg-badge-violet shrink-0 mt-1.5"
              aria-hidden="true"
            />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <p class="text-[10px] text-muted-soft leading-relaxed">
      {verifyMock.critiqueNote}
    </p>
  </div>
</TerminalFrame>
