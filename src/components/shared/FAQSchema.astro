---
import StructuredData from './StructuredData.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  questions: FAQItem[];
  webPageId?: string;
}

const { questions, webPageId } = Astro.props;

if (!questions || questions.length === 0) {
  return null;
}

const faqSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

if (webPageId) {
  faqSchema['mainEntityOfPage'] = { '@id': webPageId };
}
---

<StructuredData data={faqSchema} />
